# Copier en .env (non versionné) et renseigner les valeurs.
# Mot de passe de la base dédiée. Il est inséré dans une URL de connexion :
# n'utiliser que des caractères sûrs en URL (lettres, chiffres, - _ .).
ATELIER_DB_PASSWORD=
# Jeton exigé par le raccourci de capture d'URL depuis le téléphone.
ATELIER_CAPTURE_TOKEN=
# Port publié sur l'hôte (facultatif, 8000 par défaut).
# ATELIER_HTTP_PORT=8000
